{
  "raw_root": "raw",
  "output_root": "processed",
  "processing": {
    "history_length": 10,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "deduplicate_user_item": false,
    "split_seed": 100,
    "train_fraction": 0.8,
    "validation_fraction": 0.1,
    "sample_protocol": "one_last_target_per_user"
  },
  "datasets": {
    "Beauty": {
      "directory": "Beauty",
      "format": "amazon2014",
      "interactions": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/reviews_Beauty_5.json.gz",
      "metadata": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/meta_Beauty.json.gz"
    },
    "Toys": {
      "directory": "Toys",
      "legacy_directory": "ATG",
      "format": "amazon2014",
      "interactions": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/reviews_Toys_and_Games_5.json.gz",
      "metadata": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/meta_Toys_and_Games.json.gz"
    },
    "Sports": {
      "directory": "Sports",
      "legacy_directory": "ASO",
      "format": "amazon2014",
      "interactions": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/reviews_Sports_and_Outdoors_5.json.gz",
      "metadata": "https://snap.stanford.edu/data/amazon/productGraph/categoryFiles/meta_Sports_and_Outdoors.json.gz"
    },
    "Steam": {
      "directory": "Steam",
      "legacy_directory": "steam",
      "format": "steam_reviews",
      "interactions": "https://cseweb.ucsd.edu/~wckang/steam_reviews.json.gz",
      "metadata": "https://cseweb.ucsd.edu/~wckang/steam_games.json.gz"
    },
    "ML1M": {
      "directory": "ML1M",
      "format": "movielens1m",
      "interactions": "https://files.grouplens.org/datasets/movielens/ml-1m.zip"
    }
  }
}
